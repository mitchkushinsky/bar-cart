# Copy to .env.local and fill in. .env.local is gitignored (.env*), and
# dev.sh sources it (set -a; source .env.local) before starting vercel dev.
# Never commit real values; this file is the only .env* file git tracks.

# Browser-side (bundled into the client by Vite; public by design)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side only (api/*). Never give these a VITE_ prefix.
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
